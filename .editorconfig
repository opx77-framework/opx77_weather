root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.lua]
max_line_length = 100

[*.md]
trim_trailing_whitespace = false

# acl.jsonc and server.jsonc are edited beside this resource, never in it.
[*.{json,jsonc}]
indent_size = 2

[*.sh]
indent_size = 2
